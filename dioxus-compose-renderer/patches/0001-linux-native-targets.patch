+package androidx.compose.material3
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.ReadOnlyComposable
+import androidx.compose.ui.text.intl.Locale
+
+/**
+ * Represents a Locale for the calendar. This locale will be used when formatting dates,
+ * determining the input format, and more.
+ *
+ * The platforms with a locale object of their own point at that. This one has the locale
+ * Compose already read from the environment, which is the same answer everything else in
+ * the application is working from.
+ */
+actual typealias CalendarLocale = Locale
