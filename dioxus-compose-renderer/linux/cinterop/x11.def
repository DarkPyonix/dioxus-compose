# Xlib, GLX and the sync extension, as the window in src/LinuxWindow.kt uses them.
#
# Kotlin/Native reaches C through cinterop, and the Kotlin Toolchain finds a definition file
# by looking in this directory: there is nothing to declare in module.yaml.
#
# Kotlin/Native ships platform libraries for Linux (posix, linux, zlib, iconv) and none of
# them carries X11, so this is the whole of the window's reach outside Kotlin. There is no C
# of ours here and no wrapper: the window calls Xlib the way the macOS window calls AppKit.
#
# The headers are the system's own rather than a copy of them kept here. Copying would make
# this build on a machine with no X11 installed, and it would mean writing out the layout of
# XEvent, XSetWindowAttributes and XVisualInfo by hand, from memory, with no way to check
# them: a field at the wrong offset is a window that misbehaves on Linux for a reason nobody
# can see in the source. The real headers cannot be wrong. What they cost is that building
# this module needs the X11, Xext and GL development headers installed, which on a Linux
# machine is one package manager line and on macOS is XQuartz.
package = x11

headers = X11/Xlib.h X11/Xutil.h X11/Xatom.h X11/cursorfont.h X11/keysym.h \
          X11/extensions/sync.h GL/gl.h GL/glx.h

# Only X11's and GL's own declarations become Kotlin. Without this the klib also carries
# everything the X11 headers reach into, which is most of the C library.
headerFilter = X11/** GL/**

# -idirafter rather than -I, so these are searched after the target's own include chain
# instead of in front of it. Kotlin/Native compiles against a sysroot of its own, and a plain
# -I /usr/include would put the host distribution's libc headers ahead of that sysroot's for
# every include X11 reaches into. Searched afterwards, they answer for X11 and GL, which the
# sysroot does not have, and for nothing else.
#
# Two directories because two kinds of machine build this: /usr/include is where a Linux
# distribution puts them, /opt/X11/include is where XQuartz puts them on macOS, which is the
# cross build. A directory that is not there is not an error; clang ignores it.
compilerOpts = -idirafter /usr/include -idirafter /opt/X11/include

# Resolved when a Host executable is finally linked on Linux, not here: this module produces
# a klib. Xext is where the sync counter calls live, which is easy to miss because they are
# declared under X11/extensions and everything else in that directory is in libX11.
linkerOpts = -lX11 -lXext -lGL
