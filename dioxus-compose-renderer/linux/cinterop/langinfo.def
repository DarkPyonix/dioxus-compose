# What the C library will say about reading dates and times in this locale.
#
# The pickers ask `platformFormats()` what a month is called, which day a week starts on and
# whether the clock reads to twelve or to twenty four, and the answer has to come from the
# machine the application is running on rather than from anything the Host sent. On iOS and
# macOS that is Foundation; on Linux it is `nl_langinfo`, which Kotlin/Native's posix platform
# library does not declare.
#
# The header is in Kotlin/Native's own sysroot, so unlike the X11 definition beside this one
# nothing has to be installed for it. Only this one header: `setlocale` is already declared by the
# posix platform library, and declaring it twice would give the window two names for it.
package = langinfo

headers = langinfo.h

# No header filter. One narrowed to this header's own name bound nothing at all: the
# constants the pickers ask for are enumerators of `nl_item`, which is declared in
# `nl_types.h`, and a filter that keeps only one of the two keeps neither.

# Which day a week starts on is a GNU extension (`_NL_TIME_FIRST_WEEKDAY`) and is declared
# only when this is set. Every locale has an answer for it and POSIX has no way to ask.
compilerOpts = -D_GNU_SOURCE
