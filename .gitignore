# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# macOS
.DS_Store

# Agent worktrees
.claude/
.agent-salvage/

# Machine local cargo settings, written by scripts/setup-worktrees.sh
.cargo/config.toml

# The consumer fixture is a crate of its own, built by
# scripts/tests/consumer-crate.test.sh to prove that an application which depends only on
# dioxus-compose links and starts. Its lock file is the resolution of whatever the crate
# needs at the time, and tracking it would mean a second lock file to update on every
# dependency change, plus a dirty working tree every time the test runs.
dioxus-compose/tests/fixtures/consumer/Cargo.lock
