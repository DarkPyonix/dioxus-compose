+fn widened_columns(ctx: &TableContext, inputs: LayoutInput) -> Option<taffy::Style<Atom>> {
+    let widths = ctx.fixed_column_widths.as_ref()?;
+    let columns: f32 = widths.iter().sum();
+    if widths.is_empty() || columns <= 0.0 {
+        return None;
+    }
+
+    let style = &ctx.style;
+    let parent_width = inputs.parent_size.width;
+    let padding = style.padding.resolve_or_zero(parent_width, resolve_calc_value);
+    let border = style.border.resolve_or_zero(parent_width, resolve_calc_value);
+    let padding_border = padding.left + padding.right + border.left + border.right;
+    let box_sizing_adjustment = match style.box_sizing {
+        BoxSizing::ContentBox => padding_border,
+        BoxSizing::BorderBox => 0.0,
+    };
+    let resolve = |dimension: Dimension| {
+        dimension
+            .maybe_resolve(parent_width, resolve_calc_value)
+            .map(|width| width + box_sizing_adjustment)
