+    /// Set the `:disabled` and `:enabled` state of every form control from the document.
+    ///
+    /// A `button`, `input`, `select`, `textarea` or `fieldset` is disabled when it has the
+    /// `disabled` attribute, or when it is inside a `fieldset` that has it and not inside
+    /// that fieldset's first `legend` child. An `optgroup` is disabled by its own
+    /// attribute, and an `option` by its own or by its parent `optgroup`'s. Every other
+    /// such element is enabled, and an element that is none of these is neither.
+    ///
+    /// Stylo compares element state when it shares styles between siblings and when it
+    /// invalidates, so the state lives on the node rather than being read from the
+    /// attribute while matching. `resolve_stylist` runs this first; an element whose state
+    /// changes is snapshotted and restyled with its subtree.
+    pub fn update_form_control_states(&mut self) {
+        /// The element `node` is, when it is one in the HTML namespace.
+        fn html_element(node: &Node) -> Option<&ElementData> {
+            match &node.data {
+                NodeData::Element(element) if element.name.ns == ns!(html) => Some(element),
+                _ => None,
+            }
+        }
 
+        let both = ElementState::DISABLED_STATES;
+        let mut walk = std::mem::take(&mut self.form_control_walk);
+        walk.clear();
+        walk.push((0, false));
+        while let Some((id, in_disabled_fieldset)) = walk.pop() {
+            let node = &self.nodes[id];
+            let mut wanted = ElementState::empty();
+            let mut inner = in_disabled_fieldset;
+            let mut exempt_legend = None;
+            if let Some(element) = html_element(node) {
+                let local = &element.name.local;
+                let own = element.attr(local_name!("disabled")).is_some();
+                let disabled = if *local == local_name!("button")
+                    || *local == local_name!("input")
+                    || *local == local_name!("select")
+                    || *local == local_name!("textarea")
+                {
+                    Some(own || in_disabled_fieldset)
+                } else if *local == local_name!("fieldset") {
+                    if own {
+                        inner = true;
+                        exempt_legend = node.children.iter().copied().find(|&child| {
+                            html_element(&self.nodes[child])
+                                .is_some_and(|child| child.name.local == local_name!("legend"))
+                        });
+                    }
+                    Some(own || in_disabled_fieldset)
+                } else if *local == local_name!("optgroup") {
+                    Some(own)
+                } else if *local == local_name!("option") {
+                    let group_disabled = node
+                        .parent
+                        .and_then(|parent| html_element(&self.nodes[parent]))
+                        .is_some_and(|parent| {
+                            parent.name.local == local_name!("optgroup")
+                                && parent.attr(local_name!("disabled")).is_some()
+                        });
+                    Some(own || group_disabled)
+                } else {
+                    None
+                };
+                wanted = match disabled {
+                    Some(true) => ElementState::DISABLED,
+                    Some(false) => ElementState::ENABLED,
+                    None => ElementState::empty(),
+                };
+            }
+            for &child in node.children.iter() {
+                let flag = if Some(child) == exempt_legend {
+                    in_disabled_fieldset
+                } else {
+                    inner
+                };
+                walk.push((child, flag));
+            }
+            if node.element_state & both != wanted {
+                self.snapshot_node_and(id, |node| {
+                    node.element_state.remove(both);
+                    node.element_state.insert(wanted);
+                    node.set_restyle_hint(RestyleHint::restyle_subtree());
+                });
+            }
+        }
+        self.form_control_walk = walk;
+    }
